    font-weight: bold;
    color: #FFFFFF;
  }

  .stat-unit {
    font-size: 14px;
    color: #D6E4FF;
    margin-left: 4px;
    margin-bottom: 6px;
  }

  .stat-right {
    flex-direction: column;
    align-items: flex-end;
  }

  .stat-next-label {
    font-size: 13px;
    color: #D6E4FF;
  }

  .stat-next-value {
    font-size: 15px;
    color: #FFFFFF;
    margin-top: 6px;
    font-weight: bold;
  }

  .banner {
    border-radius: 10px;
    padding: 12px 14px;
    margin-top: 12px;
  }

  .banner-warn {
    background-color: #FFF4E5;
  }

  .banner-error {
    background-color: #FFEBEA;
  }

