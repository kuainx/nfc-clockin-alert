<template>
  <view class="page">
    <!-- 自定义导航栏（uni-ui-x / uni-nav-bar） -->
    <view class="nav-wrap">
      <uni-nav-bar :hide-default-back="true" right-class="nav-right">
        <template #mid>
          <text class="nav-title">NFC 打卡闹钟</text>
        </template>
        <template #right>
          <view class="nav-action" hover-class="nav-action-hover" @tap="goSettings">
            <text class="nav-action-text">设置</text>
          </view>
        </template>
      </uni-nav-bar>
    </view>

    <scroll-view class="content" direction="vertical">
      <!-- 累计统计 -->
      <view class="stat-card">
        <view class="stat-left">
          <text class="stat-label">累计打卡</text>
          <view class="stat-value-row">
            <text class="stat-value">{{ checkedCount }}</text>
            <text class="stat-unit">天</text>
          </view>
        </view>
        <view class="stat-right">
          <text class="stat-next-label">下次提醒</text>
          <view v-if="nextAlarmAt > 0" class="stat-next-row">
            <uni-time-format :timestamp="nextAlarmAt" format="date" :style="statNextStyle"></uni-time-format>
            <text class="stat-next-week">{{ nextAlarmWeek }}</text>
            <text class="stat-next-clock">{{ nextAlarmClock }}</text>
          </view>
          <text v-else class="stat-next-value">{{ nextAlarmText }}</text>
        </view>
      </view>

      <!-- 环境提示 -->
      <view v-if="!nfcSupported" class="banner banner-error" @tap="openEnvSettings">
        <text class="banner-text">当前设备不支持 NFC</text>
      </view>
      <view v-else-if="!nfcEnabled" class="banner banner-warn" @tap="openNfcSettingsTap">
        <text class="banner-text">NFC 未开启，点击开启</text>
      </view>
      <view v-else-if="!hasCard" class="banner banner-warn" @tap="goSettings">
        <text class="banner-text">尚未录入 NFC 卡，点击前往设置</text>
      </view>

      <!-- 日历 -->
      <view class="calendar-card">
        <view class="calendar-header">
          <view class="month-btn" @tap="prevMonth">
            <text class="month-btn-text">‹</text>
          </view>
          <text class="month-title">{{ viewYear }}年{{ viewMonth }}月</text>
          <view class="month-btn" @tap="nextMonth">
            <text class="month-btn-text">›</text>
          </view>
        </view>

        <view class="week-row">
          <text v-for="w in weekLabels" :key="w" class="week-cell">{{ w }}</text>
        </view>

        <view class="grid">
          <view v-for="cell in cells" :key="cell.key" class="grid-cell">
            <view v-if="cell.day > 0"
              :class="['day-box', cell.status == 'checked' ? 'day-checked' : (cell.status == 'skipped' ? 'day-skipped' : ''), cell.isExtra && cell.status == '' ? 'day-extra' : '', cell.isToday ? 'day-today' : '', cell.isFuture && !(cell.isExtra && cell.status == '') ? 'day-future' : '']">
              <text
                :class="['day-text', cell.status == 'checked' ? 'day-text-checked' : (cell.status == 'skipped' ? 'day-text-skipped' : ''), cell.isExtra && cell.status == '' ? 'day-extra-text' : '', cell.isFuture && !(cell.isExtra && cell.status == '') ? 'day-text-future' : '']">{{ cell.day }}</text>
            </view>
          </view>
        </view>

        <view class="legend">
          <view class="legend-item">
            <view class="legend-dot legend-dot-checked"></view>
            <text class="legend-text">已打卡</text>
          </view>
          <view class="legend-item">
            <view class="legend-ring"></view>
            <text class="legend-text">已跳过</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot legend-dot-extra"></view>
            <text class="legend-text">指定打卡日</text>
          </view>
        </view>
      </view>

      <!-- 实时信息 -->
      <view class="info-card">
        <view class="info-row">
          <text class="info-label">当前日期</text>
          <view class="info-date-row">
            <uni-time-format :timestamp="nowTs" format="date" :style="infoValueStyle"></uni-time-format>
            <text class="info-value info-weekday">{{ weekText }}</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">当前时间</text>
          <uni-time-format :timestamp="nowTs" format="time" :style="infoClockStyle"></uni-time-format>
        </view>
        <view class="info-row">
          <text class="info-label">下次计划打卡</text>
          <view v-if="nextAlarmAt > 0" class="info-date-row">
            <uni-time-format :timestamp="nextAlarmAt" format="date" :style="infoValueStyle"></uni-time-format>
            <text class="info-value info-weekday">{{ nextAlarmWeek }}</text>
            <text class="info-value info-alarm-clock">{{ nextAlarmClock }}</text>
          </view>
          <text v-else class="info-value">{{ nextAlarmText }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">今日状态</text>
          <text :class="['info-value', statusClass]">{{ statusText }}</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 提醒浮层（内置 page-container 底部弹出层） -->
    <page-container :show="reminderShow" position="bottom" :overlay="false" :round="true"
      custom-style="background-color: transparent;" @afterleave="onReminderLeave">
      <view class="reminder-panel">
        <view class="reminder-head">
          <text class="reminder-title">{{ isDeferred ? '已延迟提醒' : '打卡提醒已触发' }}</text>
          <text class="reminder-sub">{{ reminderSubText }}</text>
        </view>
        <view class="reminder-tip-row">
          <text class="reminder-tip">{{ scanHintText }}</text>
        </view>
        <view class="reminder-actions">
          <button class="btn btn-secondary" hover-class="btn-secondary-hover" @tap="onDefer">延迟 5 分钟</button>
          <button class="btn btn-primary" hover-class="btn-primary-hover" @tap="goSettings">前往设置</button>
        </view>
      </view>
    </page-container>
  </view>
</template>

<script setup lang="ts">
  import { onReady, onShow, onHide, onUnload } from '@dcloudio/uni-app'
  import {
    getConfig, getRecords, getCheckedCount, getTodayState,
    markChecked, defer,
    isNfcSupportedCheck, isNfcEnabledCheck, openNfcSettings, openAppSettings,
    beginScan, endScan, onActivityVisible, onActivityInvisible,
    rescheduleAll, getExtraDates
  } from '@/uni_modules/nfc-clockin-alert'
  import type { DayRecord, TodayState, ScanOptions } from '@/uni_modules/nfc-clockin-alert'

  const weekLabels : string[] = ['一', '二', '三', '四', '五', '六', '日']

  const checkedCount = ref(0)
  const nfcSupported = ref(true)
  const nfcEnabled = ref(true)
  const hasCard = ref(false)

  const viewYear = ref(0)
  const viewMonth = ref(0)
  const nowTs = ref(Date.now())
  const weekText = ref('')
  const nextAlarmAt = ref(0)
  const nextAlarmText = ref('--')
  const statusText = ref('未到提醒时间')
  const statusClass = ref('')
  const isRinging = ref(false)
  const isDeferred = ref(false)
  const reminderShow = ref(false)
  let reminderDismissed = false

  const infoValueStyle = 'font-size: 14px; color: #1A1A1A;'
  const infoClockStyle = 'font-size: 14px; color: #3478F6; font-weight: bold;'
  const statNextStyle = 'font-size: 15px; color: #FFFFFF; font-weight: bold;'

  const todayState = ref<TodayState>({
    date: '', status: 'idle', deferUntil: 0, nextAlarmAt: 0, ringCount: 0
  } as TodayState)

  const recordMap = ref<Map<string, string>>(new Map<string, string>())
  const extraDateMap = ref<Map<string, boolean>>(new Map<string, boolean>())

  type Cell = {
    key : string
    day : number
    status : string
    isToday : boolean
    isFuture : boolean
    isExtra : boolean
  }

  const cells = ref<Cell[]>([])

  let tickTimer : number = -1
  let scanning = false

  const reminderSubText = computed(() => {
    const state = todayState.value
    if (state.status == 'deferred' && state.deferUntil > 0) {
      const remain = Math.max(0, state.deferUntil - Date.now())
      const min = Math.floor(remain / 60000)
      const sec = Math.floor((remain % 60000) / 1000)
      return '剩余 ' + pad2(min) + ':' + pad2(sec)
    }
    return '已提醒 ' + state.ringCount + ' 次'
  })

  const scanHintText = computed(() => {
    if (!hasCard.value) {
      return '尚未录入 NFC 卡，请先前往设置录入'
    }
    if (!nfcEnabled.value) {
      return '请先开启系统 NFC 功能'
    }
    return '请将 NFC 卡贴近手机感应区完成打卡'
  })

  const nextAlarmWeek = computed(() : string => {
    return nextAlarmAt.value > 0 ? weekdayText(nextAlarmAt.value) : ''
  })

  const nextAlarmClock = computed(() : string => {
    if (nextAlarmAt.value <= 0) {
      return ''
    }
    const d = new Date(nextAlarmAt.value)
    return pad2(d.getHours()) + ':' + pad2(d.getMinutes())
  })

  function pad2(v : number) : string {
    return v < 10 ? '0' + v : '' + v
  }

  function syncReminder(ringing : boolean) : void {
    if (!ringing) {
      reminderDismissed = false
      reminderShow.value = false
      return
    }
    if (!reminderDismissed) {
      reminderShow.value = true
    }
  }

  function onReminderLeave() : void {
    reminderShow.value = false
    reminderDismissed = true
  }

  function weekdayText(ts : number) : string {
    const d = new Date(ts)
    return ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][d.getDay()]
  }

  function computeWeekText() : string {
    return weekdayText(Date.now())
  }

  function dateKey(year : number, month : number, day : number) : string {
    return '' + year + '-' + pad2(month) + '-' + pad2(day)
  }

  function nowYear() : number { return new Date().getFullYear() }
  function nowMonth() : number { return new Date().getMonth() + 1 }
  function nowDay() : number { return new Date().getDate() }

  function buildCells() : void {
    const year = viewYear.value
    const month = viewMonth.value
    const first = new Date(year, month - 1, 1)
    // getDay: 0=周日 需要转成 周一=0
    const offset = (first.getDay() + 6) % 7
    const total = new Date(year, month, 0).getDate()

    const ty = nowYear()
    const tm = nowMonth()
    const td = nowDay()

    const list : Cell[] = []
    for (let i = 0; i < offset; i++) {
      list.push({ key: 'e' + i, day: 0, status: '', isToday: false, isFuture: false, isExtra: false } as Cell)
    }
    for (let d = 1; d <= total; d++) {
      const key = dateKey(year, month, d)
      const isToday = (year == ty && month == tm && d == td)
      const isFuture = (year > ty) || (year == ty && month > tm) || (year == ty && month == tm && d > td)
      const status = recordMap.value.get(key) ?? ''
      const isExtra = extraDateMap.value.get(key) ?? false
      list.push({ key: key, day: d, status: status, isToday: isToday, isFuture: isFuture, isExtra: isExtra } as Cell)
    }
    while (list.length % 7 != 0) {
      list.push({ key: 'f' + list.length, day: 0, status: '', isToday: false, isFuture: false, isExtra: false } as Cell)
    }
    cells.value = list
  }

  function refreshExtraDates() : void {
    // #ifdef APP-ANDROID
    const map : Map<string, boolean> = new Map<string, boolean>()
    const list : string[] = getExtraDates()
    for (let i = 0; i < list.length; i++) {
      map.set(list[i], true)
    }
    extraDateMap.value = map
    // #endif
  }

  function refreshRecords() : void {
    const map : Map<string, string> = new Map<string, string>()
    const records : DayRecord[] = getRecords()
    for (let i = 0; i < records.length; i++) {
      map.set(records[i].date, records[i].status as string)
    }
    recordMap.value = map
    buildCells()
  }

  function computeStatusText(state : TodayState) : string {
    if (state.status == 'checked') {
      return '今日已打卡'
    }
    if (state.status == 'skipped') {
      return '今日已跳过'
    }
    if (state.status == 'deferred') {
      return '已延迟提醒'
    }
    if (state.status == 'ringing') {
      return '提醒中，请刷卡'
    }
    return '未到提醒时间'
  }

  function computeStatusClass(state : TodayState) : string {
    if (state.status == 'checked') return 'status-checked'
    if (state.status == 'skipped') return 'status-skipped'
    if (state.status == 'ringing' || state.status == 'deferred') return 'status-ringing'
    return ''
  }

  function refreshAll() : void {
    // #ifdef APP-ANDROID
    const cfg = getConfig()
    hasCard.value = cfg.cardId.length > 0

    nfcSupported.value = isNfcSupportedCheck()
    nfcEnabled.value = isNfcEnabledCheck()

    checkedCount.value = getCheckedCount()

    const state = getTodayState()
    todayState.value = state
    isRinging.value = (state.status == 'ringing' || state.status == 'deferred')
    isDeferred.value = (state.status == 'deferred')
    syncReminder(isRinging.value)
    statusText.value = computeStatusText(state)
    statusClass.value = computeStatusClass(state)

    nextAlarmAt.value = state.nextAlarmAt
    if (state.nextAlarmAt > 0) {
      nextAlarmText.value = '--'
    } else if (cfg.enabled) {
      nextAlarmText.value = '未设置'
    } else {
      nextAlarmText.value = '提醒已关闭'
    }

    refreshExtraDates()
    refreshRecords()
    // #endif
  }

  function ensureScan() : void {
    // #ifdef APP-ANDROID
    if (scanning) {
      return
    }
    if (!isNfcSupportedCheck() || !isNfcEnabledCheck()) {
      return
    }
    const options : ScanOptions = {
      once: false,
      timeoutMs: 0,
      onTag: (uid : string) => {
        handleTag(uid)
      },
      onError: (_code : number, message : string) => {
        console.log('NFC scan error: ' + message)
      }
    } as ScanOptions
    beginScan(options)
    scanning = true
    // #endif
  }

  function stopScanIfNeeded() : void {
    // #ifdef APP-ANDROID
    if (scanning) {
      endScan()
      scanning = false
    }
    // #endif
  }

  function handleTag(uid : string) : void {
    // #ifdef APP-ANDROID
    const cfg = getConfig()
    if (cfg.cardId.length == 0) {
      uni.showToast({ title: '请先在设置中录入 NFC 卡', icon: 'none' })
      return
    }
    const state = getTodayState()
    if (state.status == 'checked' || state.status == 'skipped') {
      uni.showToast({ title: '今日已完成记录', icon: 'none' })
      return
    }
    if (cfg.cardId.toUpperCase() != uid.toUpperCase()) {
      uni.showToast({ title: '卡片不匹配', icon: 'none' })
      return
    }
    const ok = markChecked('')
    if (ok) {
      uni.showToast({ title: '打卡成功', icon: 'success' })
      refreshAll()
    } else {
      uni.showToast({ title: '今日已完成记录', icon: 'none' })
    }
    // #endif
  }

  function onDefer() : void {
    // #ifdef APP-ANDROID
    defer(5)
    uni.showToast({ title: '已延迟 5 分钟', icon: 'none' })
    refreshAll()
    // #endif
  }

  function prevMonth() : void {
    let y = viewYear.value
    let m = viewMonth.value - 1
    if (m < 1) {
      m = 12
      y = y - 1
    }
    viewYear.value = y
    viewMonth.value = m
    buildCells()
  }

  function nextMonth() : void {
    let y = viewYear.value
    let m = viewMonth.value + 1
    if (m > 12) {
      m = 1
      y = y + 1
    }
    viewYear.value = y
    viewMonth.value = m
    buildCells()
  }

  function goSettings() : void {
    uni.navigateTo({ url: '/pages/settings/settings' })
  }

  function openNfcSettingsTap() : void {
    // #ifdef APP-ANDROID
    openNfcSettings()
    // #endif
  }

  function openEnvSettings() : void {
    // #ifdef APP-ANDROID
    openAppSettings()
    // #endif
  }

  function tick() : void {
    nowTs.value = Date.now()
    weekText.value = computeWeekText()
    // #ifdef APP-ANDROID
    const state = getTodayState()
    todayState.value = state
    isRinging.value = (state.status == 'ringing' || state.status == 'deferred')
    isDeferred.value = (state.status == 'deferred')
    syncReminder(isRinging.value)
    // #endif
  }

  function startTick() : void {
    stopTick()
    tick()
    tickTimer = setInterval(tick, 1000) as number
  }

  function stopTick() : void {
    if (tickTimer != -1) {
      clearInterval(tickTimer)
      tickTimer = -1
    }
  }

  onReady(() => {
    viewYear.value = nowYear()
    viewMonth.value = nowMonth()
    nowTs.value = Date.now()
    weekText.value = computeWeekText()
    refreshAll()
    startTick()
  })

  onShow(() => {
    // #ifdef APP-ANDROID
    rescheduleAll()
    onActivityVisible()
    // #endif
    refreshAll()
    ensureScan()
    if (tickTimer == -1) {
      startTick()
    }
  })

  onHide(() => {
    // #ifdef APP-ANDROID
    onActivityInvisible()
    // #endif
    stopScanIfNeeded()
    stopTick()
  })

  onUnload(() => {
    stopScanIfNeeded()
    stopTick()
  })
</script>

<style>
  .page {
    flex: 1;
    background-color: #F5F6F8;
  }

  .nav-wrap {
    background-color: #FFFFFF;
    flex-direction: column;
  }

  .nav-right {
    width: auto;
    margin-right: 16px;
  }

  .nav-title {
    font-size: 17px;
    font-weight: bold;
    color: #1A1A1A;
  }

  .nav-action {
    height: 32px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
  }

  .nav-action-hover {
    background-color: #F2F3F5;
  }

  .nav-action-text {
    font-size: 15px;
    color: #3478F6;
  }

  .content {
    flex: 1;
    padding-left: 16px;
    padding-right: 16px;
  }

  .stat-card {
    flex-direction: row;
    background-color: #3478F6;
    border-radius: 14px;
    padding: 18px;
    margin-top: 12px;
    align-items: center;
    justify-content: space-between;
  }

  .stat-left {
    flex-direction: column;
  }

  .stat-label {
    font-size: 13px;
    color: #D6E4FF;
  }

  .stat-value-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 4px;
  }

  .stat-value {
    font-size: 32px;
    font-weight: bold;
    color: #FFFFFF;
  }

  .stat-unit {
    font-size: 14px;
    color: #D6E4FF;
    margin-left: 4px;
    margin-bottom: 6px;
  }

  .stat-right {
    flex-direction: column;
    align-items: flex-end;
  }

  .stat-next-label {
    font-size: 13px;
    color: #D6E4FF;
  }

  .stat-next-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
  }

  .stat-next-week {
    font-size: 15px;
    color: #FFFFFF;
    font-weight: bold;
    margin-left: 6px;
  }

  .stat-next-clock {
    font-size: 15px;
    color: #FFFFFF;
    font-weight: bold;
    margin-left: 6px;
  }

  .stat-next-value {
    font-size: 15px;
    color: #FFFFFF;
    margin-top: 6px;
    font-weight: bold;
  }

  .banner {
    border-radius: 10px;
    padding: 12px 14px;
    margin-top: 12px;
  }

  .banner-warn {
    background-color: #FFF4E5;
  }

  .banner-error {
    background-color: #FFEBEA;
  }

  .banner-text {
    font-size: 13px;
    color: #B25E09;
  }

  .calendar-card {
    background-color: #FFFFFF;
    border-radius: 14px;
    padding: 16px 12px;
    margin-top: 12px;
  }

  .calendar-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
  }

  .month-btn {
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
  }

  .month-btn-text {
    font-size: 22px;
    color: #3478F6;
  }

  .month-title {
    font-size: 16px;
    font-weight: bold;
    color: #1A1A1A;
  }

  .week-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding-bottom: 6px;
  }

  .week-cell {
    width: 14.2857%;
    text-align: center;
    font-size: 12px;
    color: #9AA0A6;
  }

  .grid {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .grid-cell {
    width: 14.2857%;
    height: 42px;
    align-items: center;
    justify-content: center;
  }

  .day-box {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: transparent;
  }

  .day-checked {
    background-color: #34C759;
  }

  .day-skipped {
    border-color: #FF9500;
    background-color: transparent;
  }

  .day-today {
    border-color: #3478F6;
  }

  .day-future {
    background-color: transparent;
  }

  .day-extra {
    background-color: #EAF1FF;
    border-color: #3478F6;
  }

  .day-extra-text {
    color: #3478F6;
    font-weight: bold;
  }

  .day-text {
    font-size: 14px;
    color: #1A1A1A;
  }

  .day-text-checked {
    color: #FFFFFF;
    font-weight: bold;
  }

  .day-text-skipped {
    color: #FF9500;
    font-weight: bold;
  }

  .day-text-future {
    color: #C7C7CC;
  }

  .legend {
    flex-direction: row;
    justify-content: center;
    padding-top: 12px;
  }

  .legend-item {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
  }

  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
  }

  .legend-dot-checked {
    background-color: #34C759;
  }

  .legend-dot-extra {
    background-color: #EAF1FF;
