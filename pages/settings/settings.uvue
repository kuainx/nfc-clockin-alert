<template>
  <view class="page">
    <scroll-view class="content" direction="vertical">
      <!-- 今日不打卡 -->
      <view class="section">
        <text class="section-title">今日操作</text>
        <view class="card">
          <view class="row">
            <text class="row-label">今日状态</text>
            <text :class="['row-value', todayStatusClass]">{{ todayStatusText }}</text>
          </view>
          <view class="row-divider"></view>
          <view class="actions">
            <button :class="['btn', skipDisabled ? 'btn-disabled' : 'btn-warning']"
              :hover-class="skipDisabled ? 'btn-hover-none' : 'btn-warning-hover'" :disabled="skipDisabled"
              @tap="onSkipToday">今日不打卡</button>
          </view>
        </view>
      </view>

      <!-- NFC 卡片 -->
      <view class="section">
        <text class="section-title">NFC 卡片</text>
        <view class="card">
          <view class="row">
            <text class="row-label">绑定状态</text>
            <text :class="['row-value', hasCard ? 'value-ok' : 'value-warn']">{{ hasCard ? '已绑定' : '未绑定' }}</text>
          </view>
          <view v-if="hasCard" class="row">
            <text class="row-label">卡片 ID</text>
            <text class="row-value mono">{{ cardId }}</text>
          </view>
          <view class="row-divider"></view>
          <view class="actions">
            <button class="btn btn-secondary" hover-class="btn-secondary-hover"
              @tap="startBinding">{{ hasCard ? '重新录入' : '录入卡片' }}</button>
            <button v-if="hasCard" class="btn btn-danger" hover-class="btn-danger-hover" @tap="unbind">解除绑定</button>
          </view>
        </view>
      </view>

      <!-- 提醒设置 -->
      <view class="section">
        <text class="section-title">提醒设置</text>
        <view class="card">
          <picker mode="time" :value="startTimeValue" @change="onStartTimeChange">
            <view class="row">
              <text class="row-label">开始提示时间</text>
              <text class="row-value">{{ startTimeText }}</text>
            </view>
          </picker>
          <view class="row-divider"></view>
          <view class="row">
            <text class="row-label">提示间隔时间</text>
            <uni-number-box v-model="intervalMinute" :min="1" :max="30" :step="1"
              @change="onIntervalChange"></uni-number-box>
          </view>
        </view>
      </view>

      <!-- 指定打卡日 -->
      <view class="section">
        <text class="section-title">指定打卡日</text>
        <view class="card">
          <picker mode="selector" :range="extraOptionLabels" :value="extraOptionIndex" @change="onExtraDateChange">
            <view class="row">
              <text class="row-label">选择休息日</text>
              <text
                :class="['row-value', extraOptionLabels.length > 0 ? 'link' : 'value-warn']">{{ extraOptionLabels.length > 0 ? extraOptionLabels[extraOptionIndex] : '暂无可选休息日' }}</text>
            </view>
          </picker>
          <view class="row-divider"></view>
          <view class="actions">
            <button class="btn btn-secondary" hover-class="btn-secondary-hover" @tap="onAddExtraDate">添加到打卡日</button>
          </view>
        </view>

        <view class="extra-collapse-wrap">
          <uni-collapse :accordion="true">
            <uni-collapse-item :title="'已指定打卡日（' + extraDateItems.length + '）'" title-wrap-class="extra-collapse-title"
              title-class="extra-collapse-title-text" content-wrap-class="extra-collapse-content">
              <view class="extra-panel">
                <scroll-view class="extra-list" direction="vertical">
                  <view v-for="item in extraDateItems" :key="item.date" class="extra-item">
                    <view class="extra-item-left">
                      <text class="extra-item-date">{{ item.date }}</text>
                      <text class="extra-item-week">{{ item.week }}</text>
                    </view>
                    <view class="extra-item-del" hover-class="extra-item-del-hover" @tap="onRemoveExtraDate(item.date)">
                      <text class="extra-item-del-text">删除</text>
                    </view>
                  </view>
                  <text v-if="extraDateItems.length == 0" class="extra-empty">暂未指定，可手动添加周六 / 周日打卡</text>
                </scroll-view>
              </view>
            </uni-collapse-item>
          </uni-collapse>
        </view>
      </view>

      <!-- 运行环境检查 -->
      <view class="section">
        <text class="section-title">运行环境</text>
        <view class="card">
          <view class="row" @tap="toggleNotification">
            <text class="row-label">通知权限</text>
            <text
              :class="['row-value', notificationEnabled ? 'value-ok' : 'value-warn']">{{ notificationEnabled ? '已开启' : '未开启，点击申请' }}</text>
          </view>
          <view class="row-divider"></view>
          <view class="row" @tap="toggleBattery">
            <text class="row-label">电池优化</text>
            <text
              :class="['row-value', batteryIgnored ? 'value-ok' : 'value-warn']">{{ batteryIgnored ? '已忽略' : '未忽略，点击设置' }}</text>
          </view>
          <view class="row-divider"></view>
          <view class="row" @tap="openSettings">
            <text class="row-label">自启动 / 后台权限</text>
            <text class="row-value link">去设置</text>
          </view>
        </view>
        <text class="section-tip">部分手机需手动允许自启动与后台运行，否则可能收不到提醒。</text>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 录入卡片弹层（内置 page-container 居中弹出） -->
    <page-container :show="binding" position="center" overlay-style="background-color: rgba(0, 0, 0, 0.55);"
      @afterleave="onBindingLeave">
      <view class="overlay-card">
        <text class="overlay-title">请将 NFC 卡贴近手机感应区</text>
        <text class="overlay-sub">{{ bindRemainText }}</text>
        <button class="overlay-btn" hover-class="overlay-btn-hover" @tap="cancelBinding">取消</button>
      </view>
    </page-container>
  </view>
</template>

<script setup lang="ts">
  import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
  import {
    getConfig, saveConfig, getTodayState, markSkipped,
    isNfcSupportedCheck, isNfcEnabledCheck, openNfcSettings,
    beginScan, endScan, onActivityVisible, onActivityInvisible,
    requestNotificationPermission, notificationEnabled as isNotificationEnabled,
    isIgnoringBatteryOptimizations, requestIgnoreBatteryOptimizations, openAppSettings,
    getExtraDates, addExtraDate, removeExtraDate
  } from '@/uni_modules/nfc-clockin-alert'
  import type { ClockConfig, TodayState, ScanOptions } from '@/uni_modules/nfc-clockin-alert'

  const hasCard = ref(false)
  const cardId = ref('')
  const startHour = ref(8)
  const startMinute = ref(30)
  const intervalMinute = ref(1)
  const enabled = ref(true)

  const extraDates = ref<string[]>([])
  const extraOptionIndex = ref(0)

  type ExtraDateItem = {
    date : string
    week : string
  }

  const notificationEnabled = ref(true)
  const batteryIgnored = ref(false)
  const nfcSupported = ref(true)
  const nfcEnabled = ref(true)

  const binding = ref(false)
  const bindRemain = ref(60)
  const todayState = ref<TodayState>({ date: '', status: 'idle', deferUntil: 0, nextAlarmAt: 0, ringCount: 0 } as TodayState)

  let bindTimer : number = -1

  const startTimeText = computed(() => {
    return pad2(startHour.value) + ':' + pad2(startMinute.value)
  })

  const startTimeValue = computed(() => {
    return pad2(startHour.value) + ':' + pad2(startMinute.value)
  })

  const bindRemainText = computed(() => {
    return '倒计时 ' + bindRemain.value + ' 秒'
  })

  const extraDateItems = computed(() : ExtraDateItem[] => {
    const list : ExtraDateItem[] = []
    for (let i = 0; i < extraDates.value.length; i++) {
      const date = extraDates.value[i]
      list.push({ date: date, week: weekdayOf(date) } as ExtraDateItem)
    }
    return list
  })

  // 仅生成未来的休息日（周六 / 周日）作为可选项，并排除已添加的日期
  const extraOptionDates = computed(() : string[] => {
    const list : string[] = []
    const now = new Date()
    let cursor = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
    let count = 0
    let offset = 0
    while (count < 30 && offset < 400) {
      const d = new Date(cursor)
      const day = d.getDay()
      if (day == 0 || day == 6) {
        const date = formatDateOfDate(d)
        let exists = false
        for (let i = 0; i < extraDates.value.length; i++) {
          if (extraDates.value[i] == date) {
            exists = true
            break
          }
        }
        if (!exists) {
          list.push(date)
          count = count + 1
        }
      }
      cursor = cursor + 24 * 60 * 60 * 1000
      offset = offset + 1
    }
    return list
  })

  const extraOptionLabels = computed(() : string[] => {
    const list : string[] = []
    const dates = extraOptionDates.value
    for (let i = 0; i < dates.length; i++) {
      list.push(dates[i] + ' ' + weekdayOf(dates[i]))
    }
    return list
  })

  const todayStatusText = computed(() => {
    const s = todayState.value.status
    if (s == 'checked') return '已打卡'
    if (s == 'skipped') return '已跳过'
    if (s == 'deferred') return '已延迟'
    if (s == 'ringing') return '提醒中'
    return '未完成'
  })

  const todayStatusClass = computed(() => {
    const s = todayState.value.status
    if (s == 'checked') return 'value-ok'
    if (s == 'skipped') return 'value-warn'
    if (s == 'deferred' || s == 'ringing') return 'value-danger'
    return ''
  })

  const skipDisabled = computed(() => {
    const s = todayState.value.status
    return s == 'checked' || s == 'skipped'
  })

  function pad2(v : number) : string {
    return v < 10 ? '0' + v : '' + v
  }

  function formatDateOfDate(d : Date) : string {
    return '' + d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate())
  }

  function weekdayOf(date : string) : string {
    const parts = date.split('-')
    if (parts.length != 3) {
      return ''
    }
    const year = parseInt(parts[0])
    const month = parseInt(parts[1])
    const day = parseInt(parts[2])
    const d = new Date(year, month - 1, day)
    return ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][d.getDay()]
  }

  function loadExtraDates() : void {
    // #ifdef APP-ANDROID
    extraDates.value = getExtraDates()
    // #endif
  }

  function loadConfig() : void {
    // #ifdef APP-ANDROID
    const cfg = getConfig()
    hasCard.value = cfg.cardId.length > 0
    cardId.value = cfg.cardId
    startHour.value = cfg.startHour
    startMinute.value = cfg.startMinute
    intervalMinute.value = cfg.intervalMinute
    enabled.value = cfg.enabled
    // #endif
  }

  function loadEnv() : void {
    // #ifdef APP-ANDROID
    notificationEnabled.value = isNotificationEnabled()
    batteryIgnored.value = isIgnoringBatteryOptimizations()
    nfcSupported.value = isNfcSupportedCheck()
    nfcEnabled.value = isNfcEnabledCheck()
    todayState.value = getTodayState()
    // #endif
  }

  function persist() : void {
    // #ifdef APP-ANDROID
    const cfg : ClockConfig = {
      cardId: cardId.value,
      startHour: startHour.value,
      startMinute: startMinute.value,
      intervalMinute: intervalMinute.value,
      enabled: enabled.value
    } as ClockConfig
    saveConfig(cfg)
    // #endif
  }

  function onStartTimeChange(e : UniPickerChangeEvent) : void {
    const value = e.detail.value as string
    const parts = value.split(':')
    if (parts.length != 2) {
      return
    }
    startHour.value = parseInt(parts[0])
    startMinute.value = parseInt(parts[1])
    persist()
    uni.showToast({ title: '已保存开始时间', icon: 'none' })
  }

  function onIntervalChange(value : number) : void {
    intervalMinute.value = value
    persist()
    uni.showToast({ title: '已保存间隔时间', icon: 'none' })
  }

  /* ---------------------------- 指定打卡日 ---------------------------- */

  function onExtraDateChange(e : UniPickerChangeEvent) : void {
    extraOptionIndex.value = parseInt('' + e.detail.value)
  }

  function onAddExtraDate() : void {
    // #ifdef APP-ANDROID
    const dates = extraOptionDates.value
    if (dates.length == 0) {
      uni.showToast({ title: '暂无可选休息日', icon: 'none' })
      return
    }
    const index = extraOptionIndex.value
    if (index < 0 || index >= dates.length) {
      uni.showToast({ title: '请选择休息日', icon: 'none' })
      return
    }
    const date = dates[index]
    const ok = addExtraDate(date)
    if (ok) {
      uni.showToast({ title: '已添加打卡日', icon: 'success' })
      loadExtraDates()
      extraOptionIndex.value = 0
    } else {
      uni.showToast({ title: '添加失败，请检查日期', icon: 'none' })
    }
    // #endif
  }

  function onRemoveExtraDate(date : string) : void {
    // #ifdef APP-ANDROID
    uni.showModal({
      title: '移除打卡日',
      content: '确定移除 ' + date + ' 吗？',
      success: (res) => {
        if (res.confirm) {
          const ok = removeExtraDate(date)
          if (ok) {
            uni.showToast({ title: '已移除', icon: 'none' })
            loadExtraDates()
          }
        }
      }
    })
    // #endif
  }

  /* ---------------------------- 卡片录入 ---------------------------- */

  function startBinding() : void {
    // #ifdef APP-ANDROID
    if (!isNfcSupportedCheck()) {
      uni.showToast({ title: '当前设备不支持 NFC', icon: 'none' })
      return
    }
    if (!isNfcEnabledCheck()) {
      openNfcSettings()
      uni.showToast({ title: '请先开启系统 NFC', icon: 'none' })
      return
    }
    binding.value = true
    bindRemain.value = 60
    bindTimer = setInterval(() => {
      bindRemain.value = bindRemain.value - 1
      if (bindRemain.value <= 0) {
        cancelBinding()
        uni.showToast({ title: '未读取到卡片', icon: 'none' })
      }
    }, 1000)
    const options : ScanOptions = {
      once: true,
      timeoutMs: 60000,
      onTag: (uid : string) => {
        cardId.value = uid
        hasCard.value = true
        persist()
        cancelBinding()
        uni.showToast({ title: '卡片录入成功', icon: 'success' })
      },
      onTimeout: () => {
        cancelBinding()
        uni.showToast({ title: '未读取到卡片', icon: 'none' })
      },
      onError: (_code : number, message : string) => {
        cancelBinding()
        uni.showToast({ title: '读取失败：' + message, icon: 'none' })
      }
    } as ScanOptions
    beginScan(options)
    // #endif
  }

  function cancelBinding() : void {
    // #ifdef APP-ANDROID
    if (bindTimer != -1) {
      clearInterval(bindTimer)
      bindTimer = -1
    }
    if (binding.value) {
      endScan()
      binding.value = false
    }
    // #endif
  }

  function onBindingLeave() : void {
    cancelBinding()
  }

  function unbind() : void {
    uni.showModal({
      title: '解除绑定',
      content: '确定要解除当前 NFC 卡的绑定吗？',
      success: (res) => {
        if (res.confirm) {
          cardId.value = ''
          hasCard.value = false
          persist()
          uni.showToast({ title: '已解除绑定', icon: 'none' })
        }
      }
    })
  }

  /* ---------------------------- 今日不打卡 ---------------------------- */

  function confirmOnce(step : number) : Promise<boolean> {
    return new Promise<boolean>((resolve) => {
      uni.showModal({
        title: '今日不打卡（' + step + '/3）',
        content: step == 3 ? '这是最后一次确认，确认后将跳过今日打卡' : '确定要跳过今日打卡吗？',
        success: (res) => {
          resolve(res.confirm)
        },
        fail: (_err) => {
          resolve(false)
        }
      })
    })
  }

  async function onSkipToday() : Promise<void> {
    // #ifdef APP-ANDROID
    if (skipDisabled.value) {
      uni.showToast({ title: '今日已完成记录', icon: 'none' })
      return
    }
    const ok1 = await confirmOnce(1)
    if (!ok1) {
      uni.showToast({ title: '已取消', icon: 'none' })
      return
    }
    const ok2 = await confirmOnce(2)
    if (!ok2) {
      uni.showToast({ title: '已取消', icon: 'none' })
      return
    }
    const ok3 = await confirmOnce(3)
    if (!ok3) {
      uni.showToast({ title: '已取消', icon: 'none' })
      return
    }
    const done = markSkipped('')
    if (done) {
      uni.showToast({ title: '今日已跳过', icon: 'none' })
      loadEnv()
      setTimeout(() => {
        uni.navigateBack()
      }, 800)
    } else {
      uni.showToast({ title: '今日已完成记录', icon: 'none' })
    }
    // #endif
  }

  /* ---------------------------- 环境 ---------------------------- */

  function toggleNotification() : void {
    // #ifdef APP-ANDROID
    if (notificationEnabled.value) {
      openAppSettings()
      return
    }
    requestNotificationPermission((granted : boolean) => {
      notificationEnabled.value = granted
      uni.showToast({ title: granted ? '通知权限已开启' : '未获得通知权限', icon: 'none' })
    })
    // #endif
  }

  function toggleBattery() : void {
    // #ifdef APP-ANDROID
    requestIgnoreBatteryOptimizations()
    // #endif
  }

  function openSettings() : void {
    // #ifdef APP-ANDROID
    openAppSettings()
    // #endif
  }

  onShow(() => {
    // #ifdef APP-ANDROID
    onActivityVisible()
    // #endif
    loadConfig()
    loadEnv()
    loadExtraDates()
    extraOptionIndex.value = 0
  })

  onHide(() => {
    // #ifdef APP-ANDROID
    onActivityInvisible()
    // #endif
  })

  onUnload(() => {
    cancelBinding()
  })
</script>

<style>
  .page {
    flex: 1;
    background-color: #F5F6F8;
  }

  .content {
    flex: 1;
    padding-left: 16px;
    padding-right: 16px;
  }

  .section {
    margin-top: 16px;
  }

  .section-title {
    font-size: 13px;
    color: #9AA0A6;
    margin-left: 4px;
    margin-bottom: 8px;
  }

  .section-tip {
    font-size: 12px;
    color: #9AA0A6;
    margin-top: 8px;
    margin-left: 4px;
  }

  .card {
    background-color: #FFFFFF;
    border-radius: 14px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .row-label {
    font-size: 15px;
    color: #1A1A1A;
  }

  .row-value {
    font-size: 15px;
    color: #6B7280;
  }

  .row-divider {
    height: 1px;
    background-color: #F0F0F0;
  }

  .mono {
    font-family: monospace;
    font-size: 13px;
  }

  .value-ok {
    color: #34C759;
  }

  .value-warn {
    color: #FF9500;
  }

  .value-danger {
    color: #FF3B30;
  }

  .link {
    color: #3478F6;
  }

  .actions {
    flex-direction: row;
    padding-top: 12px;
    padding-bottom: 16px;
  }

  .btn {
    flex: 1;
    height: 44px;
    line-height: 44px;
    border-width: 0;
    border-radius: 10px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    font-size: 15px;
    font-weight: normal;
  }

  .btn-secondary {
    background-color: #F2F3F5;
    color: #1A1A1A;
  }

  .btn-secondary-hover {
    background-color: #E6E7E9;
    color: #1A1A1A;
  }

  .btn-danger {
    background-color: #FFEBEA;
    color: #FF3B30;
    margin-left: 10px;
  }

  .btn-danger-hover {
    background-color: #FFDCDA;
    color: #FF3B30;
  }

  .btn-warning {
    background-color: #FFF4E5;
    color: #B25E09;
  }

  .btn-warning-hover {
    background-color: #FFE9CF;
    color: #B25E09;
  }

  .btn-disabled {
    background-color: #F2F3F5;
    color: #C7C7CC;
  }

  .btn-hover-none {
    background-color: #F2F3F5;
    color: #C7C7CC;
  }

  .bottom-space {
    height: 40px;
  }

  .extra-collapse-wrap {
    margin-top: 10px;
  }

  .extra-collapse-title {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
  }

  .extra-collapse-title-text {
    font-size: 13px;
    color: #6B7280;
  }

  .extra-collapse-content {
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
  }

  .extra-panel {
    background-color: #FFFFFF;
    padding: 6px;
  }

  .extra-list {
    height: 168px;
  }

  .extra-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #F5F6F8;
    border-radius: 8px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 6px;
  }

  .extra-item-left {
    flex-direction: row;
    align-items: center;
  }

  .extra-item-date {
    font-size: 14px;
    color: #1A1A1A;
    font-weight: bold;
  }

  .extra-item-week {
    font-size: 12px;
    color: #3478F6;
    margin-left: 6px;
  }

  .extra-item-del {
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 6px;
    background-color: #FFEBEA;
  }

  .extra-item-del-hover {
    background-color: #FFDCDA;
  }

  .extra-item-del-text {
    font-size: 12px;
    color: #FF3B30;
  }

  .extra-empty {
    font-size: 13px;
    color: #9AA0A6;
    margin-left: 4px;
    margin-top: 4px;
  }

  .overlay-card {
    width: 280px;
    background-color: #FFFFFF;
    border-radius: 16px;
    padding: 24px;
    align-items: center;
  }

  .overlay-title {
    font-size: 16px;
    font-weight: bold;
    color: #1A1A1A;
    text-align: center;
  }

