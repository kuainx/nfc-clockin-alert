/**
 * 日期 / 时间工具（Android 平台实现）
 */

import Calendar from 'java.util.Calendar';

const ONE_MINUTE_MS : number = 60 * 1000;

function pad2(value : number) : string {
  const s = value.toString();
  return s.length == 1 ? "0" + s : s;
}

function calendarOf(timestamp : number) : Calendar {
  const cal = Calendar.getInstance();
  cal.setTimeInMillis(timestamp.toLong());
  return cal;
}

export function formatDateOf(timestamp : number) : string {
  const cal = calendarOf(timestamp);
  return "" + cal.get(Calendar.YEAR) + "-" + pad2(cal.get(Calendar.MONTH) + 1) + "-" + pad2(cal.get(Calendar.DAY_OF_MONTH));
}

export function todayString() : string {
  return formatDateOf(Date.now());
}

export function isWorkday(timestamp : number) : boolean {
  const day = calendarOf(timestamp).get(Calendar.DAY_OF_WEEK);
  return day >= Calendar.MONDAY && day <= Calendar.FRIDAY;
}

export function startOfDay(timestamp : number) : number {
  const cal = calendarOf(timestamp);
  cal.set(Calendar.HOUR_OF_DAY, 0);
  cal.set(Calendar.MINUTE, 0);
  cal.set(Calendar.SECOND, 0);
  cal.set(Calendar.MILLISECOND, 0);
  return cal.getTimeInMillis();
}

export function atTime(timestamp : number, hour : number, minute : number) : number {
  const cal = calendarOf(startOfDay(timestamp));
  cal.set(Calendar.HOUR_OF_DAY, hour.toInt());
  cal.set(Calendar.MINUTE, minute.toInt());
  cal.set(Calendar.SECOND, 0);
  cal.set(Calendar.MILLISECOND, 0);
  return cal.getTimeInMillis();
}

export function nextDayStart(timestamp : number) : number {
  const cal = calendarOf(startOfDay(timestamp));
  cal.add(Calendar.DAY_OF_MONTH, 1);
  return cal.getTimeInMillis();
}

export function workTimeOf(timestamp : number, hour : number, minute : number) : number {
  return atTime(timestamp, hour, minute);
}

export function addMinutes(timestamp : number, minutes : number) : number {
  return timestamp + minutes * ONE_MINUTE_MS;
}

export function formatTime(timestamp : number) : string {
  const cal = calendarOf(timestamp);
  return pad2(cal.get(Calendar.HOUR_OF_DAY)) + ":" + pad2(cal.get(Calendar.MINUTE));
}

/* ------------------------- 额外打卡日相关工具 ------------------------- */

/** 将 yyyy-MM-dd 解析为当天 0 点时间戳，非法返回 0 */
export function parseDateString(date : string) : number {
  const parts = date.split("-");
  if (parts.length != 3) {
    return 0;
  }
  const year = parseInt(parts[0]);
  const month = parseInt(parts[1]);
  const day = parseInt(parts[2]);
  if (isNaN(year) || isNaN(month) || isNaN(day)) {
    return 0;
  }
  const cal = Calendar.getInstance();
  cal.set(Calendar.YEAR, year.toInt());
  cal.set(Calendar.MONTH, (month - 1).toInt());
  cal.set(Calendar.DAY_OF_MONTH, day.toInt());
  cal.set(Calendar.HOUR_OF_DAY, 0);
  cal.set(Calendar.MINUTE, 0);
  cal.set(Calendar.SECOND, 0);
  cal.set(Calendar.MILLISECOND, 0);
  return cal.getTimeInMillis();
}

/** 日期排序键：yyyyMMdd，便于比较先后 */
export function dateOrderKey(date : string) : number {
  const parts = date.split("-");
  if (parts.length != 3) {
    return 0;
  }
  const year = parseInt(parts[0]);
  const month = parseInt(parts[1]);
  const day = parseInt(parts[2]);
  if (isNaN(year) || isNaN(month) || isNaN(day)) {
    return 0;
  }
  return year * 10000 + month * 100 + day;
}

function containsDate(dates : Array<string>, date : string) : boolean {
  for (let i = 0; i < dates.length; i++) {
    if (dates[i] == date) {
      return true;
    }
  }
  return false;
}

/** 是否为打卡日：工作日，或用户指定的额外打卡日（休息日） */
export function isCheckinDay(timestamp : number, extraDates : Array<string>) : boolean {
  if (isWorkday(timestamp)) {
    return true;
  }
  return containsDate(extraDates, formatDateOf(timestamp));
}

/** 从 now 起查找下一次打卡日提醒时间（工作日或额外打卡日），无则返回 0 */
export function nextCheckinTime(now : number, hour : number, minute : number, extraDates : Array<string>) : number {
  let day : number = startOfDay(now);
  for (let i = 0; i < 14; i++) {
    if (i > 0) {
      day = nextDayStart(day);
    }
    if (!isCheckinDay(day, extraDates)) {
      continue;
    }
    const target = atTime(day, hour, minute);
    if (target > now) {
      return target;
    }
  }
  return 0;
}