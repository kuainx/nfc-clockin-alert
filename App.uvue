<script setup lang="ts">
	// #ifdef APP-ANDROID
	import { rescheduleAll, requestNotificationPermission } from '@/uni_modules/nfc-clockin-alert'

	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		// #ifdef APP-ANDROID
		requestNotificationPermission(null)
		rescheduleAll()
		// #endif
	})

	// #ifdef APP-ANDROID
	onAppShow(() => {
		rescheduleAll()
	})

	onAppHide(() => {
	})

	onLastPageBackPress(() => {
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
	})
	// #endif
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>
