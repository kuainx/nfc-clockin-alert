<template>
  <view v-if="show" class="modal-mask" @tap="onMaskTap">
    <view class="modal-card" @tap.stop>
      <text v-if="title != ''" class="modal-title">{{ title }}</text>
      <text v-if="content != ''" class="modal-content">{{ content }}</text>
      <view class="modal-actions">
        <button v-if="showCancel" class="modal-btn modal-btn-cancel" hover-class="modal-btn-cancel-hover"
          @tap="onCancel">{{ cancelText }}</button>
        <button class="modal-btn modal-btn-confirm" :style="confirmStyle" hover-class="modal-btn-confirm-hover"
          @tap="onConfirm">{{ confirmText }}</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
  const props = defineProps({
    show: {
      type: Boolean,
      default: false
    },
    title: {
      type: String,
      default: ''
    },
    content: {
      type: String,
      default: ''
    },
    cancelText: {
      type: String,
      default: '取消'
    },
    confirmText: {
      type: String,
      default: '确定'
    },
    showCancel: {
      type: Boolean,
      default: true
    },
    confirmColor: {
      type: String,
      default: '#3478F6'
    },
    maskClosable: {
      type: Boolean,
      default: true
    }
  })

  const emit = defineEmits<{
    (e : 'confirm') : void
    (e : 'cancel') : void
  }>()

  const confirmStyle = computed(() : string => {
    return 'background-color: ' + props.confirmColor
  })

  function onMaskTap() : void {
    if (props.maskClosable) {
      emit('cancel')
    }
  }

  function onCancel() : void {
    emit('cancel')
  }

  function onConfirm() : void {
    emit('confirm')
  }
</script>

<style>
  .modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background-color: rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .modal-card {
    width: 300px;
    box-sizing: border-box;
    background-color: #FFFFFF;
    border-radius: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    display: flex;
    flex-direction: column;
  }

  .modal-title {
    font-size: 16px;
    font-weight: bold;
    color: #1A1A1A;
    text-align: center;
  }

  .modal-content {
    font-size: 13px;
    color: #6B7280;
    text-align: center;
    line-height: 20px;
    margin-top: 10px;
  }

  .modal-actions {
    display: flex;
    flex-direction: row;
    margin-top: 20px;
  }

  .modal-btn {
    flex: 1;
    height: 44px;
    line-height: 44px;
    border-width: 0;
    border-radius: 10px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    font-size: 15px;
  }

  .modal-btn-cancel {
    background-color: #F2F3F5;
    color: #1A1A1A;
    margin-right: 12px;
  }

  .modal-btn-cancel-hover {
    background-color: #E6E7E9;
    color: #1A1A1A;
  }

  .modal-btn-confirm {
    color: #FFFFFF;
  }

  .modal-btn-confirm-hover {
    opacity: 0.85;
  }
</style>